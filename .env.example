# =============================================================
# .env — Configurações do Trading Bot
# NUNCA commite este arquivo no Git!
# =============================================================

# --- Credenciais da Exchange ---
# Obtenha em: https://testnet.binance.vision (para Testnet)
API_KEY= #API KEY HERE!
SECRET_KEY= #SECRET API KEY HERE!

# --- Exchange ---
EXCHANGE_ID=binance
USE_TESTNET=true          # true para Testnet, false para produção
SYMBOL=BTC/USDT
TIMEFRAME=5m             # Opções: 5m, 15m, 1h, 4h

# --- Estratégia ---
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
SMA_PERIOD=200
OHLCV_LIMIT=300

# --- Gestão de Risco ---
POSITION_SIZE_PCT=0.05    # 5% do saldo por operação
STOP_LOSS_PCT=0.025       # 2.5% de stop loss
TAKE_PROFIT_PCT=0.05      # 5.0% de take profit (ratio 2:1)
DAILY_LOSS_LIMIT_PCT=0.05 # 5% — aciona o Circuit Breaker

# --- Timing ---
LOOP_INTERVAL_SECONDS=900 # 900s = 15 minutos
ERROR_RETRY_SECONDS=60    # 60s de espera após erro
API_TIMEOUT_MS=30000      # 30 segundos de timeout para API

# --- Logs ---
LOG_FILE=logs/trading_bot.log
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR, CRITICAL
